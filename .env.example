# Application and database
APP_NAME="YNotFramez Studios Booking"
DATABASE_URL="sqlite:///./studio_bookings.db"
STUDIO_EMAIL="ynotframezstudios@gmail.com"
STUDIO_TIMEZONE="Asia/Kolkata"
# Fallbacks used before database-backed Studio Settings are available.
STUDIO_OPENING_HOUR="9"
STUDIO_CLOSING_HOUR="21"
FUTURE_BOOKING_DAYS="90"
# Keep false on public deployments until online booking is ready for customers.
PUBLIC_BOOKING_ENABLED="false"

# Email delivery
# Safe local default: render messages in the console without sending them.
EMAIL_MODE="console"
EMAIL_FROM_NAME="YNotFramez Studios"
EMAIL_REPLY_TO="ynotframezstudios@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="ynotframezstudios@gmail.com"
# Use a Google App Password here. Never commit the real value.
SMTP_PASSWORD="your_google_app_password_here"
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
SMTP_TIMEOUT_SECONDS="15"

# Razorpay payments
# Safe local default. Use "api" only after adding matching Test or Live keys.
RAZORPAY_MODE="stub"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
RAZORPAY_API_BASE_URL="https://api.razorpay.com/v1"
# Used by the hosted Payment Link return route in the WhatsApp flow.
RAZORPAY_CALLBACK_BASE_URL="https://your-public-domain.example"
RAZORPAY_PAYMENT_HOLD_MINUTES="120"
RAZORPAY_TIMEOUT_SECONDS="15"
# Used only while RAZORPAY_MODE="stub".
RAZORPAY_PAYMENT_LINK_BASE_URL="https://rzp.io/i/demo"

# Admin authentication and session security
# Leave blank locally: the app creates the ignored file below automatically.
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_SECRET_FILE=".admin_session_secret"
ADMIN_SESSION_HOURS="12"
ADMIN_COOKIE_SECURE="false"

# Google Calendar synchronization
# Safe local default: no Google requests or live event changes.
CALENDAR_MODE="stub"
# Preferred: one calendar for each physical studio space.
GOOGLE_CALENDAR_STANDARD_SMALL_ID="your_cube_calendar_id@group.calendar.google.com"
GOOGLE_CALENDAR_PREMIUM_LARGE_ID="your_arena_calendar_id@group.calendar.google.com"
# Optional legacy fallback if both studios intentionally share one calendar.
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_FILE="./google-service-account.json"
# Prevent a stalled Google request from freezing every availability view.
GOOGLE_CALENDAR_TIMEOUT_SECONDS="8"

# Render team-testing deployment overrides:
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"
# GOOGLE_SERVICE_ACCOUNT_FILE="/etc/secrets/google-service-account.json"
# ADMIN_COOKIE_SECURE="true"
# Render Free blocks standard SMTP ports. Brevo's alternative SMTP relay:
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="2525"
# SMTP_USERNAME="your_brevo_smtp_login"
# SMTP_PASSWORD="your_brevo_smtp_key"
# SMTP_USE_TLS="false"
# SMTP_USE_SSL="false"
